# Copy this file to `.env.local` and fill in values from your Supabase project.
# Dashboard → Project Settings → API
#
# Without these vars the editor still works locally (Save JSON, data URLs).
# Cloud save, dashboard, asset upload, and publish require Supabase.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: used in embed snippets (defaults to http://localhost:3001 in dev)
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
